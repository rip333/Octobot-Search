# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# credentials
/gcp-key.json
/scripts/keys/

# Local outputs from scripts/. The scripts themselves are source-controlled;
# only what they generate or consume locally is ignored. See scripts/README.md.
/scripts/card_json/
/scripts/cards.md
/scripts/print-files/
/scripts/output/
/scripts/*.psd
/scripts/*.tif
/scripts/*.tiff

# Obsidian local UI state; keep the vault notes and shared app settings tracked.
/obsidian/**/.obsidian/workspace.json
/obsidian/**/.obsidian/workspace-mobile.json
